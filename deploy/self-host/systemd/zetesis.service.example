[Unit]
Description=Zetesis FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USERNAME
Group=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/zetesis
EnvironmentFile=/home/YOUR_USERNAME/zetesis/.env
ExecStart=/home/YOUR_USERNAME/zetesis/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
