POSTGRES_DB=zetesis
POSTGRES_USER=zetesis
POSTGRES_PASSWORD=zetesis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Local development database URL
DATABASE_URL=postgresql://zetesis:zetesis@localhost:5432/zetesis

# Swap DATABASE_URL to your Supabase connection string when using Supabase.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional: override the default reranker model without editing code.
ZETESIS_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L4-v2
